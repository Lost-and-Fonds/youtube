{
  "id": "youtube",
  "name": "YouTube",
  "version": "0.3.53",
  "runtime": "php",
  "api_version": "0.2",
  "entrypoint": "stashd-plugin/plugin.php",
  "helpers_lock": "stashd-plugin/helpers.lock.json",
  "kind": "input",
  "asset_capabilities": [
    {"role": "primary", "kind": "video"},
    {"role": "artwork", "kind": "image"},
    {"role": "metadata", "kind": "metadata"},
    {"role": "captions", "kind": "subtitle", "option": "include_captions"}
  ],
  "source_prefixes": ["https://www.youtube.com/", "https://youtube.com/", "https://m.youtube.com/", "https://music.youtube.com/", "https://youtu.be/", "http://www.youtube.com/", "http://youtube.com/", "http://m.youtube.com/", "http://music.youtube.com/", "http://youtu.be/"],
  "credentials": [
    {"key": "youtube-data-api", "label": "YouTube Data API key", "description": "Improves complete channel and playlist discovery.", "secret_key": "youtube_data_api_key", "secret_type": "api_key", "required": false},
    {"key": "youtube-cookies", "label": "YouTube cookies.txt", "description": "Upload a Netscape-format cookies.txt file for authenticated downloads. The file is encrypted at rest and only exposed to this plugin during acquisition.", "secret_key": "youtube_cookies_txt", "secret_type": "generic", "input_type": "file", "raw_access": true, "required": false},
    {"key": "youtube-po-token", "label": "YouTube PO token", "description": "Optional web GVS PO token. A raw token is treated as web.gvs; prefix it with another context such as mweb.gvs+ if needed.", "secret_key": "youtube_po_token", "secret_type": "generic", "input_type": "password", "raw_access": true, "required": false}
  ],
  "http_grants": [
    {"allowed_prefixes": ["https://www.youtube.com/", "https://youtube.com/", "https://m.youtube.com/", "https://music.youtube.com/", "https://youtu.be/"], "operations": ["resolve", "refresh", "complete"]},
    {"allowed_prefixes": ["https://www.googleapis.com/youtube/v3/"], "operations": ["refresh", "complete"], "credential": {"name": "youtube-data-api", "parameter": "key", "placement": "query"}}
  ],
  "helpers": {
    "yt-dlp": {"executable": "stashd-plugin/helpers/yt-dlp", "network": true},
    "deno": {"executable": "stashd-plugin/helpers/deno", "network": false},
    "ffmpeg": {"executable": "stashd-plugin/helpers/ffmpeg", "network": false}
  },
  "source_fields": [
    {"key": "url", "label": "Channel, playlist, or video URL", "type": "text", "required": true, "description": "Paste a YouTube channel, playlist, or video URL."}
  ],
  "input_options": [
    {"key": "include_shorts", "label": "Include Shorts", "type": "bool", "default": false},
    {"key": "include_live", "label": "Include live and premieres", "type": "bool", "default": false},
    {"key": "include_captions", "label": "Include creator captions", "type": "bool", "default": true},
    {"key": "include_auto_captions", "label": "Include automatic captions", "type": "bool", "default": false},
    {"key": "caption_languages", "label": "Caption languages", "type": "text", "default": "en"}
  ],
  "operations": {"complete": ["credential:youtube-data-api", "helper:yt-dlp"], "acquire": ["helper:yt-dlp"]}
}
